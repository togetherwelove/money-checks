{
  "name": "money-checks",
  "private": true,
  "version": "1.2.2",
  "packageManager": "pnpm@10.16.1",
  "scripts": {
    "build:dev": "pnpm exec expo install --check && node scripts/runExpoDoctor.mjs development && pnpm type-check && npx eas-cli build -p ios --profile development",
    "build:prod": "pnpm exec expo install --check && node scripts/runExpoDoctor.mjs production && pnpm type-check && npx eas-cli build -p ios --profile production --auto-submit",
    "db:push": "supabase db push --linked",
    "db:push:dry-run": "supabase db push --linked --dry-run",
    "start": "node scripts/startDevelopmentServer.mjs",
    "env:pull": "npx eas-cli env:pull production --path .env.local",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "test": "node --test tests/*.test.cjs",
    "lint": "biome lint src tests",
    "format": "biome format --write",
    "verify": "pnpm lint && pnpm type-check && pnpm test"
  },
  "dependencies": {
    "@expo/dom-webview": "~58.0.2",
    "@expo/metro-runtime": "~58.0.17",
    "@expo/ui": "~58.0.28",
    "@expo/vector-icons": "~15.1.1",
    "@hcaptcha/react-native-hcaptcha": "^4.0.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-native-menu/menu": "^2.0.0",
    "@react-native-picker/picker": "2.11.4",
    "@react-navigation/bottom-tabs": "7.21.0",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.14.11",
    "@supabase/supabase-js": "^2.101.1",
    "decimal.js": "^10.6.0",
    "expo": "~58.0.25",
    "expo-apple-authentication": "~58.0.3",
    "expo-auth-session": "~58.0.18",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-dev-client": "~58.0.20",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.12",
    "expo-glass-effect": "~58.0.5",
    "expo-haptics": "~58.0.8",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-mail-composer": "~58.0.4",
    "expo-notifications": "~58.1.9",
    "expo-secure-store": "~58.0.3",
    "expo-sharing": "~58.0.23",
    "expo-splash-screen": "~58.0.14",
    "expo-sqlite": "~58.0.17",
    "expo-symbols": "~58.0.5",
    "expo-task-manager": "~58.0.14",
    "expo-tracking-transparency": "~58.1.0",
    "expo-updates": "~58.0.22",
    "expo-web-browser": "~58.0.8",
    "prop-types": "15.8.1",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-google-mobile-ads": "^16.5.0",
    "react-native-pager-view": "9.0.7",
    "react-native-purchases": "^10.15.1",
    "react-native-root-siblings": "^5.0.1",
    "react-native-root-toast": "^4.0.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-webview": "14.0.1"
  },
  "expo": {
    "autolinking": {
      "android": {
        "exclude": [
          "expo-symbols"
        ]
      }
    }
  },
  "pnpm": {
    "patchedDependencies": {
      "@react-native-menu/menu@2.0.0": "patches/@react-native-menu__menu@2.0.0.patch",
      "react-native@0.88.1": "patches/react-native@0.88.1.patch"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@electric-sql/pglite": "^0.5.14",
    "@types/node": "^25.9.3",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.0",
    "typescript": "~6.0.3"
  }
}
